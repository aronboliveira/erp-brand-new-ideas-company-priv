{
  "name": "laravel/laravel",
  "type": "project",
  "description": "The Laravel Framework.",
  "keywords": [
    "framework",
    "laravel"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "anandsiddharth/laravel-paytm-wallet": "^2.0",
    "anhskohbo/no-captcha": "^3.5",
    "arkitecht/laravel-twilio": "^1.6",
    "coingate/coingate-php": "^4.1",
    "doctrine/dbal": "^3.7",
    "guzzlehttp/guzzle": "^7.8",
    "iyzico/iyzipay-php": "^2.0",
    "kkomelin/laravel-translatable-string-exporter": "^1.21",
    "laravel/fortify": "^1.25",
    "laravel/framework": "^10.10",
    "laravel/jetstream": "^4.3",
    "laravel/sanctum": "^3.2",
    "laravel/tinker": "^2.8",
    "laravel/ui": "^4.1",
    "laravelcollective/html": "^6.4",
    "league/flysystem-aws-s3-v3": "^3.16",
    "maatwebsite/excel": "^3.1",
    "mashape/unirest-php": "^3.0",
    "mercadopago/dx-php": "^2.5",
    "midtrans/midtrans-php": "^2.5",
    "milon/barcode": "^10.0",
    "mollie/mollie-api-php": "^2.25",
    "munafio/chatify": "1.2",
    "nwidart/laravel-modules": "9.*",
    "obydul/laraskrill": "^1.2",
    "orhanerday/open-ai": "^4.8",
    "paymentwall/paymentwall-php": "^2.2",
    "paytabscom/laravel_paytabs": "^1.4",
    "psr/simple-cache": "^2.0|^3.0",
    "rachidlaasri/laravel-installer": "^4.1",
    "spatie/browsershot": "^3.58",
    "spatie/laravel-google-calendar": "^3.5",
    "spatie/laravel-permission": "^5.5",
    "srmklive/paypal": "^3.0",
    "stripe/stripe-php": "^13.0",
    "twilio/sdk": "^6.43",
    "whichbrowser/parser": "^2.1",
    "xendit/xendit-php": "^2.19",
    "yoomoney/yookassa-sdk-php": "^3.1"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "^3.9",
    "barryvdh/laravel-ide-helper": "^3.1",
    "fakerphp/faker": "^1.9.1",
    "laravel/pint": "^1.0",
    "laravel/sail": "^1.18",
    "mockery/mockery": "^1.4.4",
    "nunomaduro/collision": "^7.0",
    "phpunit/phpunit": "^10.1",
    "spatie/laravel-ignition": "^2.0",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "autoload": {
    "psr-4": {
      "App\\Config\\Constants\\": [
        "app/Config/Constants/"
      ],
      "App\\Enums\\": [
        "app/Enums/"
      ],
      "App\\Exports\\": [
        "app/Exports/",
        "!app/Exports/_withPython"
      ],
      "App\\Helpers\\": [
        "app/Helpers/"
      ],
      "App\\Http\\Controllers\\Auth\\": [
        "app/Http/Controllers/Auth/"
      ],
      "App\\Http\\Controllers\\": [
        "app/Http/Controllers/Activity/",
        "app/Http/Controllers/Bills/",
        "app/Http/Controllers/Bugs/",
        "app/Http/Controllers/Charts/",
        "app/Http/Controllers/Companies/",
        "app/Http/Controllers/Configs/",
        "app/Http/Controllers/Contact/",
        "app/Http/Controllers/Individuals/",
        "app/Http/Controllers/Info/",
        "app/Http/Controllers/Planning/",
        "app/Http/Controllers/Products/",
        "app/Http/Controllers/Shapes/",
        "app/Http/Controllers/Ssr/"
      ],
      "App\\Imports\\": [
        "app/Imports/",
        "!app/Imports/_withPython"
      ],
      "App\\Jobs\\": [
        "app/Jobs/"
      ],
      "App\\Logging\\": [
        "app/Logging/"
      ],
      "App\\Models\\": [
        "app/Models/Activity",
        "app/Models/Bills",
        "app/Models/Bugs",
        "app/Models/Charts",
        "app/Models/Companies",
        "app/Models/Configs",
        "app/Models/Contact",
        "app/Models/Individuals",
        "app/Models/Info",
        "app/Models/Planning",
        "app/Models/Products",
        "app/Models/Shapes",
        "app/Models/Ssr",
        "app/Models/Abstracts",
        "app/Models/Abstracts/Entities",
        "app/Models/Abstracts/Fields",
        "app/Models/utils",
        "app/Models/_dev"
      ],
      "App\\Traits\\": [
        "app/Traits/",
        "app/Http/Controllers/Traits/",
        "app/Models/Traits"
      ],
      "App\\Services\\": [
        "app/Services/"
      ],
      "App\\Services\\Contracts\\": [
        "app/Services/Contracts/"
      ],
      "App\\Services\\DTO\\": [
        "app/Services/DTO/"
      ],
      "App\\Services\\Resolvers\\": [
        "app/Services/Resolvers/"
      ],
      "App\\Services\\Providers\\": [
        "app/Services/Providers/"
      ],
      "App\\": [
        "app/",
        "!app/Models/",
        "!app/Traits/",
        "!app/Http/Controllers/",
        "!app/Exports/",
        "!app/Imports/"
      ],
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/",
      "Modules\\": "Modules/",
      "Modules\\LandingPage\\Config\\Constants\\": [
        "Modules/LandingPage/Config/Constants"
      ],
      "Modules\\LandingPage\\Database\\Factories\\": [
        "Modules/LandingPage/Database/Factories"
      ],
      "Modules\\LandingPage\\Entities\\": [
        "Modules/LandingPage/Entities"
      ]
    },
    "exclude-from-classmap": [
      "app/tests/",
      "app/Http/_Controllers_old/",
      "app/Exports/_withPython/",
      "app/Imports/_withPython/",
      "tests/",
      "tests/Unit/",
      "tests/Feature/",
      "**/tests/**",
      "**/*Test.php",
      "**/*TestCase.php"
    ],
    "files": [
      "app/Http/Controllers/Controller.php",
      "app/Models/Helpers/fields.php",
      "app/Http/Controllers/Helpers/http.php",
      "app/Http/Controllers/Helpers/ErrorHandlers.php",
      "app/Http/Controllers/Helpers/security.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "clear-logs": [
      "@php -r 'foreach (glob(\"./storage/logs/*.log\") as $f) { file_put_contents($f, \"\"); }' && echo \"Logs cleared successfully.\""
    ],
    "rm-logs": [
      "find storage/logs -type f -name '*.log' -exec rm -f {} \\; && echo \"Logs removal complete.\" || echo \"Logs removal attempted.\""
    ],
    "clear-logs-ps": [
      "powershell -Command \"Get-ChildItem -Path 'storage/logs/*.log' | Clear-Content; Write-Host 'Logs cleared successfully.' -ForegroundColor Green\""
    ],
    "rm-logs-ps": [
      "powershell -Command \"Get-ChildItem -Path 'storage/logs/*.log' | Remove-Item -Force; Write-Host 'Logs removed successfully.' -ForegroundColor Green\""
    ],
    "clear-all-cache": [
      "@php artisan clear-compiled",
      "@php artisan cache:clear",
      "@php artisan config:clear",
      "@php artisan optimize:clear",
      "@php artisan route:clear",
      "@php artisan view:clear",
      "@composer dump-autoload -o"
    ],
    "serve-ps--hard": [
      "@php artisan db:wipe --drop-views --force",
      "@php artisan migrate",
      "@php artisan permission:cache-reset",
      "@php artisan config:clear || true",
      "@php artisan cache:clear || true",
      "@php artisan optimize:clear || true",
      "@php artisan route:clear || true",
      "@php artisan view:clear || true",
      "@php artisan clear-compiled",
      "@php -r \"@unlink('bootstrap/cache/services.php');\" || true",
      "@php -r \"@unlink('bootstrap/cache/packages.php');\" || true",
      "@php -r \"@unlink('bootstrap/cache/compiled.php');\" || true",
      "@php -r \"@unlink('bootstrap/cache/routes.php');\" || true",
      "@composer dump-autoload -o",
      "@php artisan migrate:status",
      "@php artisan migrate:reset",
      "@php artisan migrate:fresh --seed --force || php artisan migrate:refresh --seed --force",
      "@php artisan route:list --sort=uri",
      "@php artisan serve"
    ],
    "serve-ps--mixed": [
      "@php artisan permission:cache-reset",
      "@php artisan config:clear",
      "@php artisan cache:clear",
      "@php artisan optimize:clear",
      "@php artisan route:clear",
      "@php artisan view:clear",
      "@php artisan clear-compiled",
      "@php -r \"@unlink('bootstrap/cache/services.php');\"",
      "@php -r \"@unlink('bootstrap/cache/packages.php');\"",
      "@php -r \"@unlink('bootstrap/cache/compiled.php');\"",
      "@php -r \"@unlink('bootstrap/cache/routes.php');\"",
      "@composer dump-autoload -o",
      "@php artisan migrate:status",
      "@php artisan migrate:reset",
      "@php artisan migrate:fresh --seed --force",
      "@php artisan serve"
    ],
    "serve-ps--soft": [
      "@php artisan clear-compiled",
      "@php -r \"@unlink('bootstrap/cache/services.php');\"",
      "@php -r \"@unlink('bootstrap/cache/packages.php');\"",
      "@php -r \"@unlink('bootstrap/cache/compiled.php');\"",
      "@php -r \"@unlink('bootstrap/cache/routes.php');\"",
      "@composer dump-autoload -o",
      "@php artisan migrate:status",
      "@php artisan migrate:reset",
      "@php artisan migrate:fresh --seed",
      "@php artisan serve"
    ],
    "serve-sh--hard": [
      "@php artisan db:wipe --drop-views --force",
      "@php artisan migrate",
      "@php artisan permission:cache-reset",
      "@php artisan config:clear || true",
      "@php artisan cache:clear || true",
      "@php artisan optimize:clear || true",
      "@php artisan route:clear || true",
      "@php artisan view:clear || true",
      "@php artisan clear-compiled",
      "rm -f bootstrap/cache/services.php bootstrap/cache/packages.php bootstrap/cache/compiled.php bootstrap/cache/routes.php",
      "@composer dump-autoload -o",
      "@php artisan migrate:status",
      "@php artisan migrate:reset",
      "@php artisan migrate:fresh --seed --force || php artisan migrate:refresh --seed --force",
      "@php artisan serve"
    ],
    "serve-sh--mixed": [
      "@php artisan permission:cache-reset",
      "@php artisan config:clear",
      "@php artisan cache:clear",
      "@php artisan optimize:clear",
      "@php artisan route:clear",
      "@php artisan view:clear",
      "@php artisan clear-compiled",
      "rm -f bootstrap/cache/services.php bootstrap/cache/packages.php bootstrap/cache/compiled.php bootstrap/cache/routes.php",
      "@composer dump-autoload -o",
      "@php artisan migrate:status",
      "@php artisan migrate:reset",
      "@php artisan migrate:fresh --seed",
      "@php artisan serve"
    ],
    "serve-sh--soft": [
      "@php artisan clear-compiled",
      "@composer dump-autoload -o",
      "@php artisan migrate:status",
      "@php artisan migrate:reset",
      "@php artisan migrate:fresh --seed",
      "@php artisan serve"
    ],
    "serve-ps": "@serve-ps--mixed",
    "serve-sh": "@serve-sh--soft",
    "serve--hard": "@serve-ps--hard",
    "serve--mixed": "@serve-ps--mixed",
    "serve--soft": "@serve-ps--soft",
    "serve--ps": "@serve-ps--soft",
    "serve--sh": "@serve-sh--mixed",
    "artisan-serve-ps--hard": "@serve-ps--hard",
    "artisan-serve-ps--mixed": "@serve-ps--mixed",
    "artisan-serve-ps--soft": "@serve-ps--soft",
    "artisan-serve-sh--hard": "@serve-sh--hard",
    "artisan-serve-sh--mixed": "@serve-sh--mixed",
    "artisan-serve-sh--soft": "@serve-sh--soft",
    "artisan-serve-ps": "@serve-ps--soft",
    "artisan-serve-sh": "@serve-sh--soft",
    "artisan-serve--hard": "@serve-ps--hard",
    "artisan-serve--mixed": "@serve-ps--mixed",
    "artisan-serve--soft": "@serve-ps--soft",
    "artisan-serve--ps": "@serve-ps--soft",
    "artisan-serve--sh": "@serve-sh--soft",
    "artisan-serve": "@serve-ps--soft",
    "artclrs-ps--hard": "@serve-ps--hard",
    "artclrs-ps--mixed": "@serve-ps--mixed",
    "artclrs-ps--soft": "@serve-ps--soft",
    "artclrs-sh--hard": "@serve-sh--hard",
    "artclrs-sh--mixed": "@serve-sh--mixed",
    "artclrs-sh--soft": "@serve-sh--soft",
    "artclrs-ps": "@serve-ps--soft",
    "artclrs-sh": "@serve-sh--soft",
    "artclrs--hard": "@serve-ps--hard",
    "artclrs--mixed": "@serve-ps--mixed",
    "artclrs--soft": "@serve-ps--soft",
    "artclrs--ps": "@serve-ps--soft",
    "artclrs--sh": "@serve-sh--soft",
    "artclrs": "@serve-ps--soft",
    "artisan-artclrs-ps--hard": "@serve-ps--hard",
    "artisan-artclrs-ps--mixed": "@serve-ps--mixed",
    "artisan-artclrs-ps--soft": "@serve-ps--soft",
    "artisan-artclrs-sh--hard": "@serve-sh--hard",
    "artisan-artclrs-sh--mixed": "@serve-sh--mixed",
    "artisan-artclrs-sh--soft": "@serve-sh--soft",
    "artisan-artclrs-ps": "@serve-ps--soft",
    "artisan-artclrs-sh": "@serve-sh--soft",
    "artisan-artclrs--hard": "@serve-ps--hard",
    "artisan-artclrs--mixed": "@serve-ps--mixed",
    "artisan-artclrs--soft": "@serve-ps--soft",
    "artisan-artclrs--ps": "@serve-ps--soft",
    "artisan-artclrs--sh": "@serve-sh--soft",
    "artisan-artclrs": "@serve-ps--soft",
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "process-timeout": 0
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
