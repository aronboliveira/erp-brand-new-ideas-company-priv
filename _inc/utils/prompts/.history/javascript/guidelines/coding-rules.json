{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ERP Prestech JS/TS Coding Guidelines",
  "version": "1.0.0",
  "updated": "2026-03-06",
  "description": "Deep nested complex entries for automated tooling and linters.",
  "rules": {
    "dry": {
      "setAttribute": {
        "enabled": true,
        "threshold": 3,
        "description": "Refactor ≥3 consecutive setAttribute on same element to Object.entries loop",
        "pattern": {
          "type": "loop",
          "iterator": "Object.entries",
          "body": "element.setAttribute(k, v)"
        }
      },
      "propertyAssign": {
        "enabled": true,
        "threshold": 3,
        "description": "Refactor ≥3 consecutive property assignments on same element to Object.entries loop",
        "pattern": {
          "type": "loop",
          "iterator": "Object.entries",
          "body": "(element as Record<string, unknown>)[k] = v"
        }
      },
      "cachedStrings": {
        "enabled": true,
        "threshold": 2,
        "description": "Extract string literals used >2 times into named constants",
        "naming": ["camelCase", "UPPER_SNAKE_CASE"],
        "scope": "file-level or nearest shared scope"
      }
    },
    "formatting": {
      "blankLines": {
        "betweenRelatedStatements": false,
        "betweenTopLevelFunctions": true,
        "afterImports": true,
        "description": "No blank lines between guards, declarations, and tightly coupled statements"
      },
      "declarations": {
        "collapseSequential": true,
        "maxMerge": 3,
        "keywords": ["const", "let", "var"],
        "separator": ",",
        "skipWhen": [
          "complex-destructuring",
          "multiline-initializers",
          "readability-concern"
        ]
      },
      "braces": {
        "singleStatementIf": "omit",
        "singleStatementElse": "omit",
        "preferredPatterns": {
          "guardPlusCall": {
            "style": "short-circuit",
            "example": "!cond && action()"
          },
          "symmetricBranches": {
            "style": "ternary",
            "example": "cond ? actionA() : actionB()"
          }
        }
      }
    },
    "jsdoc": {
      "functionDeclarations": {
        "required": true,
        "minContent": "one-line summary"
      },
      "namedFunctionExpressions": {
        "required": true,
        "minContent": "one-line summary"
      },
      "arrowCallbacks": {
        "required": false,
        "note": "Omit when intent is obvious from context"
      },
      "doNotRepeat": ["parameterTypes", "returnType", "generic constraints"]
    },
    "iife": {
      "tryCatch": {
        "required": true,
        "scope": "entire IIFE body",
        "catchBehavior": {
          "action": "console.error",
          "messageTemplate": "[{moduleName}] failed to initialise:",
          "includeError": true
        }
      }
    },
    "dom": {
      "queryPreference": [
        {
          "rank": 1,
          "method": "document.getElementById",
          "returns": "Element | null"
        },
        {
          "rank": 2,
          "method": "document.getElementsByClassName",
          "returns": "HTMLCollection"
        },
        {
          "rank": 3,
          "method": "document.getElementsByTagName",
          "returns": "HTMLCollection"
        },
        {
          "rank": 4,
          "method": "HTMLFormElement.elements",
          "returns": "HTMLFormControlsCollection"
        },
        {
          "rank": 5,
          "method": "document.querySelector",
          "returns": "Element | null"
        },
        {
          "rank": 6,
          "method": "document.querySelectorAll",
          "returns": "NodeList"
        }
      ],
      "observers": {
        "MutationObserver": {
          "required": false,
          "note": "Use only when demonstrably beneficial"
        },
        "IntersectionObserver": {
          "required": false,
          "note": "Use only when demonstrably beneficial"
        }
      },
      "formElements": {
        "preferHTMLFormControlsCollection": true,
        "namedItemForRadios": true,
        "description": "Use form.elements and namedItem() for form field access when applicable"
      }
    },
    "es": {
      "target": "ES6+",
      "preferredFeatures": [
        "arrow-functions",
        "template-literals",
        "const-let",
        "destructuring",
        "spread-operator",
        "optional-chaining",
        "nullish-coalescing",
        "Object.entries",
        "Array.from",
        "for-of"
      ]
    },
    "browser": {
      "support": ["chromium", "gecko"],
      "avoidWebkitOnly": true
    },
    "testing": {
      "afterChanges": {
        "required": true,
        "suites": ["jest", "playwright", "eslint", "tsc --noEmit"],
        "mockHtmlPages": "when necessary for DOM tests"
      },
      "performance": {
        "benchmarkBeforeSwitching": true,
        "criteria": "most performant implementation wins"
      }
    },
    "cacheStringsRegexp": {
      "enabled": true,
      "stringThreshold": 2,
      "regexpThreshold": 1,
      "description": "Strings used 2+ times → local const. RegExp always cached at scope level. Cross-file shared strings → .constants.ts in Object.freeze({...} as const)",
      "sharedFile": ".constants.ts",
      "sharedFormat": "Object.freeze({ ... } as const)"
    },
    "sequentialToIterative": {
      "enabled": true,
      "description": "Sequential same-target calls must be iterative or combined",
      "patterns": {
        "appendChildChain": "for (const [p,c] of pairs) p.appendChild(c)",
        "styleAssignments": "Object.assign(el.style, { ... })",
        "jqueryRemoveClass": "el.removeClass('a b c') — space-separated"
      }
    },
    "eventListenerGuards": {
      "enabled": true,
      "description": "Check el.dataset.<name>Bound before addEventListener; set to '1' after binding",
      "check": "el.dataset.<name>Bound",
      "setAfterBind": "\"1\""
    },
    "inlineSingleUse": {
      "enabled": true,
      "description": "Variables assigned once and used once should be inlined unless the name significantly clarifies intent",
      "exceptions": [
        "complex-expressions-where-name-adds-clarity",
        "debugging-convenience"
      ]
    },
    "vendorFileMarking": {
      "enabled": true,
      "severity": "error",
      "description": "All third-party/vendor/bundle TS files inside ts/src/ must have '// # ! VENDOR FILE — DO NOT EDIT' as first non-empty line. Path must be excluded from tsconfig.json and eslint.config.mjs.",
      "header": "// # ! VENDOR FILE — DO NOT EDIT",
      "requiredConfigEntries": [
        "tsconfig.json > exclude",
        "eslint.config.mjs > ignores"
      ],
      "currentFiles": [
        "public/assets/js/vendor-all.ts",
        "public/js/cookieconsent.ts",
        "public/js/site.ts",
        "public/js/app.ts",
        "public/Modules/landingpage/js/vendor-all.ts",
        "public/Modules/landingpage/js/app.ts"
      ]
    },
    "eslintMigrationConfig": {
      "enabled": true,
      "severity": "info",
      "description": "During JS→TS migration certain rules are disabled. Re-enable after full retyping.",
      "disabledRules": [
        {
          "rule": "@typescript-eslint/strict-boolean-expressions",
          "reason": "~1100 false positives from defensive if(el)/if(str) null-guards"
        },
        {
          "rule": "@typescript-eslint/no-unnecessary-condition",
          "reason": "~1300 false positives from truthy checks on runtime-nullable values"
        }
      ],
      "varsIgnorePattern": "^_|^\\$|^jQuery|^bootstrap|^feather|^SimpleBar|^dragula",
      "caughtErrorsIgnorePattern": ".*"
    },
    "asyncReturnTypes": {
      "enabled": true,
      "severity": "error",
      "description": "Async functions must use Promise<void>, never bare void (tsc TS1064). Non-async void → : void. Complex inferred returns → eslint-disable-next-line.",
      "rules": {
        "nonAsyncVoid": ": void",
        "asyncVoid": ": Promise<void>",
        "asyncBareVoid": "forbidden",
        "complexInferredReturns": "eslint-disable-next-line @typescript-eslint/explicit-function-return-type"
      }
    },
    "eslintDisablePatterns": {
      "enabled": true,
      "severity": "warning",
      "description": "eslint-disable-next-line must be used sparingly and correctly.",
      "rules": {
        "neverInsideTemplateLiterals": true,
        "combineMultipleRulesInOneComment": true,
        "addReasonWhenNonObvious": true,
        "preferFixingRootCause": true
      }
    }
  }
}
