<?xml version="1.0"?>
<ruleset name="ERP Prestech">
    <description>PSR-12 base with Laravel conventions, all violations reported as info</description>

    <file>app/</file>
    <file>config/</file>
    <file>database/</file>
    <file>routes/</file>
    <file>Modules/</file>
    <file>tests/</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/storage/*</exclude-pattern>
    <exclude-pattern>*/bootstrap/cache/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*_ide_helper*.php</exclude-pattern>
    <exclude-pattern>*.blade.php</exclude-pattern>

    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>
    <config name="php_version" value="80100"/>

    <config name="severity" value="1"/>
    <config name="warning_severity" value="1"/>
    <config name="error_severity" value="1"/>

    <rule ref="PSR12">
        <severity>1</severity>
    </rule>

    <rule ref="PSR12.Files.FileHeader"/>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
        <severity>1</severity>
    </rule>

    <rule ref="Generic.WhiteSpace.ScopeIndent">
        <properties>
            <property name="indent" value="4"/>
            <property name="tabIndent" value="false"/>
        </properties>
        <severity>1</severity>
    </rule>

    <rule ref="Generic.PHP.RequireStrictTypes">
        <severity>1</severity>
    </rule>

    <rule ref="Generic.Arrays.DisallowLongArraySyntax">
        <severity>1</severity>
    </rule>

    <rule ref="Squiz.PHP.DisallowMultipleAssignments">
        <severity>1</severity>
    </rule>

    <rule ref="Squiz.WhiteSpace.SuperfluousWhitespace">
        <severity>1</severity>
    </rule>

    <rule ref="PSR2.Methods.MethodDeclaration"/>
    <rule ref="PSR2.Classes.PropertyDeclaration"/>

    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <severity>1</severity>
    </rule>
</ruleset>