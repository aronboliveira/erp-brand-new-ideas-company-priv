APP_NAME='ERP Brand New Ideas Company'
APP_DESC='O novo ERP da Brand New Ideas Company, otimizado para o seu sucesso!'
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_URL=http://localhost/
APP_TIMEZONE=America/Sao_Paulo

NEXT_PUBLIC_APP_URL="http://localhost:3001/"
NEXT_PUBLIC_APP_URL_SHORT="localhost:3001"
NEXT_BRAND_NEW_IDEAS_COMPANY_PUBLIC_APP_URL="https://sistema.brandnewideascompany.com/"
NEXT_BRAND_NEW_IDEAS_COMPANY_PUBLIC_APP_URL_SHORT="sistema.brandnewideascompany.com"
NEXT_API_URL="api.brandnewideascompany.com"

DEFAULT_LOCALE=en
THEME_COLOR='blue'
RECAPTCHA_MODULE=off

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_LEVEL_STDERR=debug
LOG_LEVEL_SYS=debug
LOG_LEVEL_ERR=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp_brand_new_ideas_company_db
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
QUEUE_DRIVER=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Seeder profiles: minimal | standard | full
# minimal  = foundation only (~1 min)
# standard = all mock data   (~10-30 min)
# full     = exhaustive      (hours — use long-version seeders from _inc/.seeders/)
SEED_PROFILE=standard
# SEED_ONLY=BillSeeder,InvoiceSeeder    # run ONLY these (plus foundation)
# SEED_SKIP=PurchaseSeeder,TaskSeeder   # exclude these from the profile
