<?xml version="1.0" encoding="UTF-8"?>
<!--
  test_suites.xml
  Format: XML — complex nested / hierarchical data structure
  Purpose: Full test infrastructure map for ERP Nova Prestech
  Last updated: 2026-03-04
  Stack: PHPUnit 10.5.55, Jest 30.1.3, Playwright 1.52.0, Pytest 8.x, PHPStan/Larastan 3.9.3
  Config files:
    - phpunit.xml       (_inc/laravel/phpunit.xml)
    - jest.config.cjs   (_inc/laravel/jest.config.cjs)
    - playwright.config — root level (_test.sh references)
    - pytest.ini        (if present, root level)
-->
<test-infrastructure app="erp-nova-prestech" last-run="2026-03">

  <!-- ============================
       PHPUnit (backend)
       ============================ -->
  <!-- IMPORTANT: NEVER use "php artisan test" — it uses .env database (production).
       Always use composer scripts or vendor/bin/phpunit directly. -->
  <suite name="PHPUnit" runner="phpunit" version="10.5.55"
         config="_inc/laravel/phpunit.xml"
         env-file="_inc/laravel/.env.testing"
         command="cd _inc/laravel &amp;&amp; composer run test:phpunit">

    <sub-suite name="Unit" directory="tests/Unit" namespace="Tests\Unit" file-count="414">
      <description>Fast isolated unit tests — most are stubs with markTestSkipped</description>
      <categories>
        <category name="Models"      pattern="tests/Unit/Models/*Test.php"/>
        <category name="Services"    pattern="tests/Unit/Services/*Test.php"/>
        <category name="Helpers"     pattern="tests/Unit/Helpers/*Test.php"/>
        <category name="Constants"   pattern="tests/Unit/Constants/*Test.php"/>
      </categories>
      <note>Run with composer run test:unit</note>
    </sub-suite>

    <sub-suite name="Feature" directory="tests/Feature" namespace="Tests\Feature" file-count="8">
      <description>Integration tests — uses MySQL test DB (erp_prestech_test) via DatabaseTransactions</description>
      <categories>
        <category name="Dashboard"   pattern="tests/Feature/DashboardDataTest.php"/>
        <category name="Auth"        pattern="tests/Feature/Auth/*Test.php"/>
        <category name="Controllers" pattern="tests/Feature/Http/*Test.php"/>
        <category name="API"         pattern="tests/Feature/Api/*Test.php"/>
      </categories>
      <env>
        <var name="DB_CONNECTION" value="mysql"/>
        <var name="DB_DATABASE"   value="erp_prestech_test"/>
      </env>
    </sub-suite>

    <commands>
      <command label="All tests (safe)"  exec="composer run test:phpunit"/>
      <command label="Unit only"         exec="composer run test:unit"/>
      <command label="Feature only"      exec="composer run test:feature"/>
      <command label="Feature filter"    exec="composer run test:feature:filter -- ClassName"/>
      <command label="Single test"       exec="APP_ENV=testing php vendor/bin/phpunit --filter=TestName --no-coverage"/>
      <command label="DANGEROUS — NEVER" exec="php artisan test (WIPES PRODUCTION DB)"/>
    </commands>

    <last-known-result passed="26" failed="0" skipped="0" assertions="88"
                       date="2026-03-04" note="DashboardDataTest — all green, MySQL test DB"/>
  </suite>


  <!-- ============================
       Jest (frontend JS/TS unit)
       ============================ -->
  <!-- ============================
       PHPStan / Larastan
       ============================ -->
  <suite name="PHPStan" runner="phpstan" version="2.1.17"
         larastan="3.9.3"
         config="_inc/laravel/phpstan.neon"
         module-config="_inc/laravel/phpstan-module.neon"
         module-runner="_inc/laravel/scripts/phpstan-modules.sh"
         command="cd _inc/laravel &amp;&amp; composer run phpstan">

    <description>Static analysis with Larastan (Laravel PHPStan wrapper)</description>

    <levels>
      <level n="2" errors="0" date="2026-03-04" status="clean"/>
      <level n="3" status="module-by-module in progress" modules="25"/>
    </levels>

    <modules count="25">
      <module name="Activity" /><module name="Auth" /><module name="Bills" />
      <module name="Bugs" /><module name="Charts" /><module name="Companies" />
      <module name="Configs" /><module name="Contact" /><module name="Individuals" />
      <module name="Info" /><module name="Planning" /><module name="Products" />
      <module name="Shapes" /><module name="Ssr" /><module name="Helpers" />
      <module name="Abstracts" /><module name="Traits" /><module name="Services" />
      <module name="Exports" /><module name="Imports" /><module name="Jobs" />
      <module name="Mail" /><module name="Providers" /><module name="Console" />
      <module name="Middleware" />
    </modules>

    <commands>
      <command label="Level 2 (master)"   exec="composer run phpstan:l2"/>
      <command label="Level 3 (master)"   exec="composer run phpstan:l3"/>
      <command label="Per-module L3"      exec="composer run phpstan:modules"/>
      <command label="Single module"      exec="bash scripts/phpstan-modules.sh 3 Bills"/>
      <command label="Clear cache"        exec="composer run phpstan:clear"/>
    </commands>

    <note>BillController (1582 lines) requires single-process mode (phpstan-module.neon, 1800s timeout)</note>

    <last-known-result level2-errors="0" level3-status="in-progress" date="2026-03-04"/>
  </suite>


  <suite name="Jest" runner="jest" version="30.1.3"
         config="_inc/laravel/jest.config.cjs"
         command="cd _inc/laravel &amp;&amp; npx jest --config jest.config.cjs --verbose"
         tsconfig="_inc/laravel/tsconfig.json"
         babel="_inc/laravel/babel.config.cjs">

    <sub-suite name="Frontend Unit" directory="resources/js/__tests__">
      <description>Unit tests for JS/TS modules in resources/js</description>
      <categories>
        <category name="Components" pattern="resources/js/__tests__/components/*.test.ts"/>
        <category name="Utilities" pattern="resources/js/__tests__/utils/*.test.ts"/>
        <category name="Hooks"     pattern="resources/js/__tests__/hooks/*.test.ts"/>
      </categories>
    </sub-suite>

    <sub-suite name="Root Scripts" directory="__tests__" note="Tests for top-level .js files (_test.js etc.)">
      <categories>
        <category name="Root scripts" pattern="__tests__/*.test.js"/>
      </categories>
    </sub-suite>

    <env>
      <var name="NODE_ENV"   value="test"/>
      <var name="TS_JEST"    value="enabled"/>
    </env>

    <commands>
      <command label="All"              exec="npm test"/>
      <command label="Watch mode"       exec="npm test -- --watch"/>
      <command label="Coverage"         exec="npm test -- --coverage"/>
      <command label="Filter by name"   exec="npm test -- --testNamePattern='pattern'"/>
      <command label="Single file"      exec="npm test -- path/to/file.test.ts"/>
    </commands>

    <last-known-result passed="?" failed="0" skipped="0" note="Run to update"/>
  </suite>


  <!-- ============================
       Playwright (E2E)
       ============================ -->
  <suite name="Playwright" runner="playwright" version="1.52.0"
         config="_test.sh"
         command="npx playwright test"
         base-url="http://localhost:8000">

    <description>End-to-end browser tests covering auth flow, CRUD operations, and UI regressions</description>

    <projects>
      <project name="chromium"  browser="chromium"  channel="default"/>
      <project name="firefox"   browser="firefox"   channel="default"/>
      <project name="webkit"    browser="webkit"    channel="default"/>
      <project name="mobile-chrome"  browser="chromium" device="Pixel 5"/>
      <project name="mobile-safari"  browser="webkit"   device="iPhone 12"/>
    </projects>

    <test-groups>
      <group name="Auth"        pattern="tests/playwright/auth/*.spec.ts"   description="Login, logout, register, forgot password"/>
      <group name="Dashboard"   pattern="tests/playwright/dashboard/*.spec.ts"/>
      <group name="Invoices"    pattern="tests/playwright/invoices/*.spec.ts"/>
      <group name="Employees"   pattern="tests/playwright/employees/*.spec.ts"/>
      <group name="CRUD"        pattern="tests/playwright/crud/*.spec.ts"   description="Generic create/read/update/delete flows"/>
      <group name="Permissions" pattern="tests/playwright/permissions/*.spec.ts" description="Role-based access checks"/>
    </test-groups>

    <commands>
      <command label="All browsers"       exec="npx playwright test"/>
      <command label="Headed (debug)"     exec="npx playwright test --headed"/>
      <command label="Single project"     exec="npx playwright test --project=chromium"/>
      <command label="Single file"        exec="npx playwright test tests/playwright/auth/login.spec.ts"/>
      <command label="UI Debug mode"      exec="npx playwright test --ui"/>
      <command label="Trace viewer"       exec="npx playwright show-trace trace.zip"/>
      <command label="Workers=4"          exec="npx playwright test --workers=4"/>
      <command label="Retries=2"          exec="npx playwright test --retries=2"/>
    </commands>

    <last-known-result passed="1909" failed="0" skipped="1"
                       note="Last full run: 2026-02 — 5 browser projects"/>
  </suite>


  <!-- ============================
       Pytest (minor / scripts)
       ============================ -->
  <suite name="Pytest" runner="pytest" version="latest"
         command="pytest"
         scope="Root-level Python scripts only (_test.py, obf.js helper tests)">

    <description>Minimal Python test suite — covers utility scripts in root, not the Laravel app</description>

    <test-groups>
      <group name="Root scripts" pattern="_test*.py" description="Tests for root Python helper scripts"/>
    </test-groups>

    <commands>
      <command label="All"        exec="pytest"/>
      <command label="Verbose"    exec="pytest -v"/>
      <command label="Single"     exec="pytest _test.py"/>
    </commands>

    <last-known-result passed="?" failed="0" skipped="0" note="Very small suite — run separately"/>
  </suite>


  <!-- ============================
       Test Environment Setup
       ============================ -->
  <setup-prerequisites>
    <step order="1">Ensure server is running: <code>cd _inc/laravel &amp;&amp; php artisan serve --port=8000</code></step>
    <step order="2">Ensure test DB is migrated: <code>composer run db:test:migrate</code></step>
    <step order="3">Ensure SA user exists: UUID <code>a3e8f4b2-7c1d-4f5a-9b0c-82d6e1f3a5b7</code>,
      email <code>suporte@prestech.com.br</code>, password <code>test1234</code></step>
    <step order="4">For Playwright: ensure <code>npx playwright install</code> has been run for all browser engines</step>
    <step order="5">For PHPUnit Feature tests: confirm <code>phpunit.xml</code> has <code>DB_DATABASE=erp_prestech_test</code> and <code>.env.testing</code> exists</step>
    <step order="6">For PHPStan: run <code>composer run phpstan:clear</code> if cache issues arise</step>
  </setup-prerequisites>

  <!-- ============================
       Known Flaky / Skipped Tests
       ============================ -->
  <flaky-or-skipped>
    <item suite="Playwright" test="calendar sync" reason="Google Calendar credentials not present in test env — always skip"/>
    <item suite="PHPUnit"    test="PaytabsWebhookTest" reason="Paytabs SDK namespace fix pending — temporarily skipped"/>
    <item suite="Jest"       test="QR Code component" reason="DNS2D package not available in Node env — mock required"/>
  </flaky-or-skipped>

</test-infrastructure>
