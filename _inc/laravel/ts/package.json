{
  "name": "@erp-prestech/ts-src",
  "version": "1.0.0",
  "description": "TypeScript source files mirroring the app JS in public/, resources/, tests/",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "build:watch": "tsc --build --watch",
    "build:clean": "rm -rf dist && tsc --build",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "eslint src --max-warnings=80",
    "lint:fix": "eslint src --max-warnings=80 --fix",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs --coverage",
    "test:harness": "npx playwright test --config=playwright.harness.config.ts",
    "test:harness:headed": "npx playwright test --config=playwright.harness.config.ts --headed",
    "test:harness:ui": "npx playwright test --config=playwright.harness.config.ts --ui",
    "test:harness:chromium": "npx playwright test --config=playwright.harness.config.ts --project=chromium",
    "test:harness:firefox": "npx playwright test --config=playwright.harness.config.ts --project=firefox",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs tests/unit",
    "serve:harness": "node tests/serve-harness.cjs",
    "test:all": "npm run build && npm run lint && npm run test:unit && npm run test:harness",
    "test:e2e": "npm run build && npm run test:harness",
    "clean": "rm -rf dist node_modules/.cache coverage tsconfig.tsbuildinfo",
    "prebuild": "npm run clean"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.37",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "globals": "^14.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "erp",
    "typescript",
    "frontend",
    "migration"
  ],
  "author": "Aron Barbosa de Oliveira & Douglas Silva",
  "license": "UNLICENSED"
}
