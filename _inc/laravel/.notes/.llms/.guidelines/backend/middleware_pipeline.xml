<?xml version="1.0" encoding="UTF-8"?>
<!--
  middleware_pipeline.xml
  Format: XML — complex nested/procedural instruction set
  Purpose: Full Laravel HTTP middleware pipeline for ERP Nova Prestech
  Last updated: 2026-03-01
  Source: _inc/laravel/app/Http/Kernel.php, app/Http/Middleware/, app/Traits/
-->
<middleware-pipeline app="erp-nova-prestech" laravel="10.x">

  <!-- ============================================================
       GLOBAL MIDDLEWARE (run on every request)
       ============================================================ -->
  <global-stack>
    <middleware order="1" class="App\Http\Middleware\TrustProxies"
                purpose="Set trusted proxies for load balancers / reverse proxy (nginx)"/>
    <middleware order="2" class="Illuminate\Http\Middleware\HandleCors"
                purpose="CORS headers — config/cors.php"/>
    <middleware order="3" class="App\Http\Middleware\PreventRequestsDuringMaintenance"
                purpose="503 during artisan down"/>
    <middleware order="4" class="Illuminate\Foundation\Http\Middleware\ValidatePostSize"
                purpose="Reject oversized POST bodies"/>
    <middleware order="5" class="App\Http\Middleware\TrimStrings"
                purpose="Auto-trim all string inputs (except password fields)"/>
    <middleware order="6" class="Illuminate\Foundation\Http\Middleware\ConvertEmptyStringsToNull"
                purpose="Empty string → null before hitting controllers"/>
  </global-stack>

  <!-- ============================================================
       MIDDLEWARE GROUPS
       ============================================================ -->
  <groups>

    <group name="web" alias="MWC::WEB">
      <description>Applied to every route in routes/web.php via RouteServiceProvider</description>
      <middleware order="1"  class="App\Http\Middleware\EncryptCookies"/>
      <middleware order="2"  class="Illuminate\Cookie\Middleware\AddQueuedCookiesToResponse"/>
      <middleware order="3"  class="Illuminate\Session\Middleware\StartSession"/>
      <middleware order="4"  class="Illuminate\View\Middleware\ShareErrorsFromSession"
                             purpose="$errors bag available in all Blade views"/>
      <middleware order="5"  class="App\Http\Middleware\VerifyCsrfToken"
                             note="Except routes listed in VerifyCsrfToken::$except"/>
      <middleware order="6"  class="Illuminate\Routing\Middleware\SubstituteBindings"
                             purpose="Route model binding resolution"/>
      <middleware order="7"  class="App\Http\Middleware\XSSProtection"
                             alias="MWC::XSS"
                             purpose="Strips &lt;script&gt; tags from request inputs"/>
    </group>

    <group name="api" alias="MWC::API">
      <description>Applied to routes/api.php — stateless, token-based (Sanctum)</description>
      <middleware order="1" class="Illuminate\Routing\Middleware\ThrottleRequests:api"/>
      <middleware order="2" class="Illuminate\Routing\Middleware\SubstituteBindings"/>
    </group>

  </groups>

  <!-- ============================================================
       ROUTE-LEVEL MIDDLEWARE ALIASES
       ============================================================ -->
  <route-middleware-aliases>
    <alias name="MWC::AUTH"   class="Illuminate\Auth\Middleware\Authenticate"
                              maps-to="auth:sanctum"
                              note="Most protected routes use auth:sanctum"/>
    <alias name="MWC::GUEST"  class="App\Http\Middleware\RedirectIfAuthenticated"
                              maps-to="guest"/>
    <alias name="MWC::REV"    class="Illuminate\Auth\Middleware\EnsureEmailIsVerified"
                              maps-to="verified"/>
    <alias name="MWC::XSS"    class="App\Http\Middleware\XSSProtection"/>
    <alias name="can"         class="Illuminate\Auth\Middleware\Authorize"/>
    <alias name="signed"      class="Illuminate\Routing\Middleware\ValidateSignature"/>
    <alias name="throttle"    class="Illuminate\Routing\Middleware\ThrottleRequests"/>
    <alias name="fortify-auth" class="App\Http\Middleware\FortifyAuthentication"
                              note="Custom Fortify middleware for login routes"/>
  </route-middleware-aliases>

  <!-- ============================================================
       FULL ROUTE REQUEST PIPELINE (step-by-step for protected routes)
       ============================================================ -->
  <route-flow description="Example: GET /invoices/index (auth-protected web route)">

    <step order="1" layer="Global">
      <action>TrustProxies, PreventRequestsDuringMaintenance, ValidatePostSize, TrimStrings, ConvertEmptyStringsToNull</action>
    </step>

    <step order="2" layer="Group: web">
      <action>EncryptCookies → AddQueuedCookiesToResponse → StartSession → ShareErrorsFromSession → VerifyCsrfToken → SubstituteBindings → XSSProtection</action>
    </step>

    <step order="3" layer="Route Middleware: auth:sanctum">
      <action>Check if user is authenticated via Sanctum session token</action>
      <on-fail>Redirect to /login (or JSON 401 for API)</on-fail>
      <on-pass>Attach $request->user() as the authenticated User model</on-pass>
    </step>

    <step order="4" layer="Controller: __construct()">
      <action>Resolved from IoC container; middleware applied in constructor if any</action>
    </step>

    <step order="5" layer="Controller Method: index() / show() / etc.">
      <substep order="5.1">
        <action>self::_checkLogin() via ChecksLogin trait</action>
        <detail>
          - Calls Auth::user() — if null or session expired → return redirect('/login')
          - Returns User model on success
          - Sets $this->user
        </detail>
      </substep>
      <substep order="5.2">
        <action>self::guard($request, PMC::PERM_CONSTANT, REDIRECT_ROUTE) via ChecksPermissions trait</action>
        <detail>
          - Gets $userType from User model via getUserType()
          - PMC::SA bypasses all checks → returns true immediately
          - For non-SA: checks permission name against user type whitelist array
          - If forbidden → returns redirect(REDIRECT_ROUTE) with error flash
          - If allowed → returns true
        </detail>
      </substep>
      <substep order="5.3">
        <action>Business logic, model queries, view rendering</action>
        <detail>View::exists() check before returning view(); logs warning if missing</detail>
      </substep>
    </step>

    <step order="6" layer="Response">
      <action>View compiled → Response sent through middleware stack in reverse order</action>
    </step>

  </route-flow>

  <!-- ============================================================
       GUARD FLOW LOGIC (ChecksPermissions trait)
       ============================================================ -->
  <guard-flow class="App\Traits\ChecksPermissions" method="guard()">
    <input>
      <param name="$request"    type="Illuminate\Http\Request"/>
      <param name="$permission" type="string" example="PMC::INVOICES_VIEW"/>
      <param name="$redirect"   type="string" example="VW::DSB"/>
    </input>
    <logic>
      <branch condition="$userType === PMC::SA">
        <return>true (skip all checks)</return>
      </branch>
      <branch condition="!in_array($permission, $allowedPermissions[$userType] ?? [])">
        <return>redirect($redirect)-&gt;with('error', __('permission_denied'))</return>
      </branch>
      <branch condition="else">
        <return>true</return>
      </branch>
    </logic>
  </guard-flow>

  <!-- ============================================================
       MIDDLEWARE THAT AFFECTS PERFORMANCE / DEBUGGING
       ============================================================ -->
  <notes>
    <note key="xss_caveat">XSSProtection runs strip_tags() on all string inputs — safe for text fields,
      but will strip HTML from any RTE / rich-text fields. Guard those fields explicitly.</note>
    <note key="csrf_except">PayTabs IPN webhook and external calendar callbacks are in VerifyCsrfToken::$except</note>
    <note key="session_driver">Session driver = file (config/session.php). For horizontal scaling, switch to redis/database.</note>
    <note key="sanctum_spa">SPA authentication uses Sanctum cookie-based session, not Bearer tokens. /sanctum/csrf-cookie must be called first.</note>
  </notes>

</middleware-pipeline>
