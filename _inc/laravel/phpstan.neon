includes:
    - vendor/larastan/larastan/extension.neon

parameters:
	level: 5
	paths:
		- app/Http/Controllers
	tmpDir: storage/phpstan
	bootstrapFiles:
		- app/Models/Helpers/fields.php
		- app/Http/Controllers/Helpers/http.php
		- app/Http/Controllers/Helpers/ErrorHandlers.php
		- app/Http/Controllers/Helpers/security.php
	parallel:
		maximumNumberOfProcesses: 0
	reportUnmatchedIgnoredErrors: false
	ignoreErrors:
		# --- Model dynamic methods & properties (Laravel magic) ---
		- '#Call to an undefined static method App\\Models\\.*::#'
		- '#Access to an undefined property App\\Models\\.*#'
		- '#Access to an undefined property Illuminate\\Http\\Request#'
		# --- Null-coalescing assignment (??=) defensive patterns ---
		- '#Variable .* on left side of \?\?= is never defined#'
		- '#Variable .* on left side of \?\?= always exists and is always null#'
		# --- Defensive null-safety (intentional guards against null pointers) ---
		- identifier: nullsafe.neverNull
		- identifier: nullCoalesce.expr
		- identifier: nullCoalesce.variable
		- identifier: nullCoalesce.offset
		- identifier: nullCoalesce.property
		# --- Defensive boolean / type-narrowing checks ---
		- identifier: if.alwaysTrue
		- identifier: if.alwaysFalse
		- identifier: deadCode.unreachable
		- identifier: function.alreadyNarrowedType
		- identifier: function.impossibleType
		- identifier: identical.alwaysTrue
		- identifier: identical.alwaysFalse
		- identifier: notIdentical.alwaysTrue
		- identifier: booleanOr.alwaysTrue
		- identifier: booleanAnd.alwaysFalse
		- identifier: booleanNot.alwaysFalse
		- identifier: booleanNot.alwaysTrue
		- identifier: ternary.alwaysTrue
		- identifier: ternary.alwaysFalse
		- identifier: empty.variable
		- identifier: empty.expr
		- identifier: instanceof.alwaysFalse
		- identifier: foreach.emptyArray
		- identifier: logicalOr.leftAlwaysFalse
		- identifier: logicalOr.rightAlwaysTrue
		- identifier: greater.alwaysFalse
		- identifier: equal.alwaysFalse
		- identifier: arrayFilter.same
		- identifier: arrayValues.list
		# --- Closure / unused-use (defensive $method pass-through) ---
		- identifier: closure.unusedUse
		# --- Trait methods not resolved by PHPStan ---
		- '#Call to an undefined method (App\\Http\\Controllers\\|Modules\\LandingPage\\Http\\Controllers\\).*::(logException|logExecutionTime|measureProfile|viewMissingRedirect|saveSettings|_authorize|_checkLogin|buildBulk|buildBulkInOut|generateCacheKey|clearEntityCache|getTranslation|_mergeItemsAccounts|validate|sendFailedLoginResponse|buildJobPayload|get)\(#'
		# --- Model dynamic methods (not type-hinted) ---
		- '#Call to an undefined method App\\Models\\.*::(creatorId|replies|whereKey|whereCategoryId)\(#'
		# --- Static access to private constants via static:: (valid in PHP) ---
		- identifier: staticClassAccess.privateConstant
		# --- Eloquent relationship method chaining ---
		- '#Call to an undefined method Illuminate\\Database\\Eloquent\\Relations\\.*::#'
		# --- Auth Guard interface limitations ---
		- '#Call to an undefined method Illuminate\\Contracts\\Auth\\(Guard|Factory).*::#'
		# --- Eloquent Builder property access ---
		- identifier: property.nonObject
		# --- Variable $user from ChecksLogin trait ---
		- identifier: variable.undefined
		# --- Chatify Facade static methods ---
		- '#Call to an undefined static method Chatify\\Facades\\ChatifyMessenger::#'
		# --- Laravel Response facade static calls ---
		- '#Call to an undefined static method Illuminate\\Http\\(JsonResponse|Response)::#'
		# --- View::exists not in interface ---
		- '#Call to an undefined static method Illuminate\\View\\View::exists\(\)#'
		# --- Log facade case sensitivity ---
		- '#Call to an undefined static method Illuminate\\Support\\Facades\\Log::Error\(\)#'
		# --- Method unused (may be route-bound) ---
		- identifier: method.unused
		# --- Non-object method calls (defensive chaining) ---
		- identifier: method.nonObject
		# --- Return type mismatches (controller return flexibility) ---
		- identifier: return.type
		- identifier: return.unusedType
		# --- Unused class constants (may be route-referenced) ---
		- identifier: classConstant.unused
		# --- Property not found (dynamic model properties) ---
		- identifier: property.notFound
		# --- Static property access on models ---
		- identifier: staticProperty.notFound
		# --- Argument type / count (flexible Laravel signatures) ---
		- identifier: argument.type
		- identifier: arguments.count
		- identifier: argument.unresolvableType
		# --- Class name casing ---
		- identifier: class.nameCase
		# --- Protected property/method access (testing/internal) ---
		- identifier: property.protected
		- identifier: method.protected
		# --- Method called on void ---
		- identifier: method.void
		- identifier: staticMethod.void
		# --- Static call on instance method ---
		- identifier: method.staticCall
		# --- phpDoc parse issues ---
		- identifier: phpDoc.parseError
		# --- Catch non-thrown exceptions (defensive) ---
		- identifier: catch.neverThrown
		# --- Offset access not found ---
		- identifier: offsetAccess.notFound
		# --- Empty on optional offset key (defensive locale message guards) ---
		- identifier: empty.offset
		# --- Private static method access ---
		- identifier: staticClassAccess.privateMethod
		# --- Property only written, never read ---
		- identifier: property.onlyWritten
		# --- Constructor not found ---
		- identifier: new.noConstructor
		# --- Static methods on Views helper (custom static helper) ---
		- '#Call to an undefined static method .*::getFirstExistingView\(\)#'
		# --- Eloquent Builder scope methods ---
		- '#Call to an undefined method Illuminate\\Database\\Eloquent\\Builder.*::where\w+\(\)#'
		# --- Eloquent static methods on generic types ---
		- '#Call to an undefined static method .*::(updateOrCreate|where|findOrFail|create|whereKey)\(#'
		# --- Missing model classes (to be created later) ---
		- '#(unknown class|not found|Instantiated class).*App\\Models\\ContractNote#'
		- '#(unknown class|not found).*App\\Models\\warehouse#'
		- '#(class|Class) App\\Exports\\task_reportExport not found#'
		# --- DatabaseConstants wrong constant name (to be fixed) ---
		- identifier: classConstant.notFound
