{
  "name": "erp-brand-new-ideas-company-frontend-tests",
  "version": "1.0.0",
  "description": "Frontend unit tests for ERP Brand New Ideas Company Laravel application",
  "private": true,
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "test:core": "jest --testPathPattern=core/",
    "test:generic": "jest --testPathPattern=generic/",
    "test:pages": "jest --testPathPattern=pages/",
    "test:routes": "jest --testPathPattern=routes/"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.1",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "http-proxy-agent": {
      "@tootallnate/once": "^3.0.1"
    }
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "rootDir": ".",
    "testMatch": [
      "**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "clearMocks": true,
    "restoreMocks": true,
    "resetMocks": true,
    "verbose": true,
    "collectCoverageFrom": [
      "../../../public/assets/js/**/*.js",
      "!../../../public/assets/js/**/*.min.js",
      "!../../../public/assets/js/dist/**"
    ],
    "coverageDirectory": "./coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}
