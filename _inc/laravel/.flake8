[flake8]
ignore = E101, E111, E114, E126, E128, E225, E226, E231, E261, E301, E302, E701, W191, W503
max-line-length = 160
max-doc-length = 160
indent-size = 4
exclude =
    __pycache__,
    .venv,
    venv,
    .git,
    .tox,
    dist,
    build,
    *.egg-info,
    migrations,
    node_modules,
    vendor
extend-exclude =
    tests/fixtures,
    storage
filename = *.py
per-file-ignores =
    __init__.py:F401
    conftest.py:F401,S101
    tests/*:S101
count = true
statistics = true
show-source = true
jobs = auto
docstring-convention = google