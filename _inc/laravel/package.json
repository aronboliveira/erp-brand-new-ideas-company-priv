{
  "name": "erp-nova-prestech",
  "author": "Aron Barbosa de Oliveira & Douglas Silva",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev:vite": "vite",
    "build:vite": "vite build",
    "preview:vite": "vite preview",
    "legacy:dev": "npm run development",
    "development:mix": "mix",
    "watch:mix": "mix watch",
    "watch-h:mix": "mix watch --hot",
    "watch-poll:mix": "mix watch -- --watch-options-poll=1000",
    "legacy:prod": "npm run production",
    "production:mix": "mix --production",
    "__ ISOLATED TESTING (subagent-friendly) __": "--- section marker ---",
    "test:jest:core": "npx jest --config jest.config.cjs --verbose",
    "test:jest:core:watch": "npx jest --config jest.config.cjs --verbose --watch",
    "test:jest:pages": "cd tests/frontend/js && npx jest pages/ --verbose",
    "test:jest:generic": "cd tests/frontend/js && npx jest generic/ --verbose",
    "test:jest:e2e": "cd tests/frontend/js && npx jest e2e/ --verbose",
    "test:playwright": "npx playwright test --config=playwright.config.cjs --reporter=list",
    "test:playwright:headed": "npx playwright test --config=playwright.config.cjs --headed --reporter=list",
    "test:playwright:debug": "npx playwright test --config=playwright.config.cjs --debug",
    "__ FRONTEND MOCK PAGE TESTS __": "--- section marker ---",
    "test:frontend": "npx playwright test --config=playwright-frontend.config.cjs",
    "test:frontend:rbac": "npx playwright test --config=playwright-frontend.config.cjs rbac.spec.ts",
    "test:frontend:api": "npx playwright test --config=playwright-frontend.config.cjs api-responses.spec.ts",
    "test:frontend:forms": "npx playwright test --config=playwright-frontend.config.cjs forms.spec.ts",
    "test:frontend:nav": "npx playwright test --config=playwright-frontend.config.cjs navigation.spec.ts",
    "test:frontend:headed": "npx playwright test --config=playwright-frontend.config.cjs --headed",
    "test:frontend:debug": "npx playwright test --config=playwright-frontend.config.cjs --debug",
    "test:frontend:ui": "npx playwright test --config=playwright-frontend.config.cjs --ui",
    "test:frontend:report": "npx playwright show-report tests/frontend/js/playwright-report",
    "test:frontend:jest": "npx jest --config tests/frontend/jest.frontend.config.cjs --runInBand --verbose",
    "test:frontend:eslint": "npx eslint --config tests/frontend/eslint.frontend.config.mjs tests/frontend/js --ext .cjs,.ts --max-warnings=0",
    "test:frontend:all": "npm run test:frontend:eslint && npm run test:frontend:jest && npm run test:frontend",
    "test:eslint": "npx eslint public/assets/js/ --ext .js --max-warnings=50 || true",
    "test:all": "npm run test:jest:core && npm run test && npm run test:playwright && npm run test:frontend",
    "__ PYTHON TESTS __": "--- section marker ---",
    "test:pytest": "cd tests/python && . .venv/bin/activate && pytest -v --tb=short",
    "test:pytest:quick": "cd tests/python && . .venv/bin/activate && pytest -x -q",
    "test:pytest:setup": "cd tests/python && bash bootstrap-venv.sh",
    "__ CURL / HTTP BENCHMARKS __": "--- section marker ---",
    "test:curl:timing": "bash tests/curl_timing.sh",
    "test:postman": "cd tests/postman && bash run-postman.sh",
    "__ CROSS-STACK RUNNERS __": "--- section marker ---",
    "test:backend": "composer run test:phpunit && npm run test:pytest",
    "test:fullstack": "npm run test:jest:core && npm run test:playwright && npm run test:pytest && npm run test:frontend",
    "__ STATIC ANALYSIS __": "--- section marker ---",
    "phpstan": "composer run phpstan",
    "phpstan:modules": "composer run phpstan:modules",
    "phpstan:clear": "composer run phpstan:clear"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@tailwindcss/forms": "^0.4.0",
    "@tanstack/react-query": "^5.71.1",
    "@tanstack/react-query-devtools": "^5.72.0",
    "autoprefixer": "^10.4.2",
    "axios": "^1.4.0",
    "context": "^4.0.0",
    "date-fns": "^2.30.0",
    "emoji-mart": "5.5.2",
    "file-type": "^18.0.0",
    "gn-api-sdk-node": "3.0.4",
    "i18next": "^22.5.0",
    "i18next-browser-languagedetector": "^6.1.5",
    "lodash": "^4.17.19",
    "markdown-to-jsx": "^7.1.2",
    "mic-recorder-to-mp3": "2.2.2",
    "moment": "^2.29.4",
    "next": "15.2.4",
    "qrcode.react": "4.1.0",
    "query-string": "^7.1.1",
    "react": "^18.3.1",
    "react-color": "2.19.3",
    "react-copy-to-clipboard": "5.1.0",
    "react-csv": "2.2.2",
    "react-dom": "^18.3.1",
    "react-error-boundary": "5.0.0",
    "react-icons": "^4.8.0",
    "react-input-mask": "^2.0.4",
    "react-modal-image": "^2.5.1",
    "react-number-format": "^4.6.5",
    "react-qr-code": "2.0.15",
    "react-text-mask": "5.5.0",
    "react-trello": "2.2.11",
    "recharts": "^2.1.14",
    "sass": "^1.89.2",
    "socket.io-client": "^4.6.1",
    "sweetalert2": "^11.17.2",
    "tailwindcss": "^3.0.18",
    "text-mask-addons": "3.8.0",
    "use-debounce": "10.0.3",
    "use-sound": "4.0.4",
    "uuid": "11.0.5",
    "wowjs": "^1.1.3",
    "yup": "1.5.0"
  },
  "devDependencies": {
    "@date-io/date-fns": "^2.15.0",
    "@eslint/eslintrc": "^3",
    "@mui/icons-material": "^5.14.0",
    "@mui/lab": "^5.0.0-alpha.125",
    "@mui/material": "^5.17.1",
    "@mui/styles": "^5.14.0",
    "@mui/x-date-pickers": "^6.0.0",
    "@next/eslint-plugin-next": "^15.3.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/node": "^20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "babel-jest": "^29.5.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "eslint": "^9.24.0",
    "eslint-config-next": "15.2.4",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.2.0",
    "laravel-mix": "^6.0.49",
    "typescript": "^5",
    "vanilla-cookieconsent": "^2.9.2",
    "vite": "^7.3.1",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1"
  }
}
