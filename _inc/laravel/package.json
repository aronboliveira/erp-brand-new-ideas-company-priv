{
  "name": "erp-brand-new-ideas-company",
  "author": "Aron Barbosa de Oliveira & Douglas Silva",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "tests/frontend/js"
  ],
  "scripts": {
    "auth:refresh": "node tests/e2e/auth.setup.cjs",
    "e2e": "node tests/e2e/auth.setup.cjs && npx playwright test tests/e2e/ --reporter=list --timeout=60000",
    "e2e:headed": "node tests/e2e/auth.setup.cjs && npx playwright test tests/e2e/ --headed --reporter=list --timeout=60000",
    "e2e:debug": "node tests/e2e/auth.setup.cjs && npx playwright test tests/e2e/ --debug",
    "test": "npm run test --workspace=tests/frontend/js",
    "test:coverage": "npm run test:coverage --workspace=tests/frontend/js",
    "test:watch": "npm run test:watch --workspace=tests/frontend/js",
    "test:curl": "python3 ../utils/.llms/scripts/curl_route_tester.py --parallel 6 --timeout 10",
    "test:curl:fail": "python3 ../utils/.llms/scripts/curl_route_tester.py --parallel 6 --timeout 10 --only-failures",
    "smoke:routes": "python3 ../utils/.llms/scripts/smoke_test_routes.py",
    "smoke:routes:auth": "python3 ../utils/.llms/scripts/smoke_test_authenticated.py",
    "audit:routes": "python3 ../utils/.llms/scripts/audit_route_constants.py",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev:vite": "vite",
    "build:vite": "vite build",
    "preview:vite": "vite preview",
    "legacy:dev": "npm run development",
    "development:mix": "mix",
    "watch:mix": "mix watch",
    "watch-h:mix": "mix watch --hot",
    "watch-poll:mix": "mix watch -- --watch-options-poll=1000",
    "legacy:prod": "npm run production",
    "production:mix": "mix --production",
    "__ ISOLATED TESTING (subagent-friendly) __": "--- section marker ---",
    "test:jest:core": "npx jest --config jest.config.cjs --verbose",
    "test:jest:core:watch": "npx jest --config jest.config.cjs --verbose --watch",
    "test:jest:pages": "cd tests/frontend/js && npx jest pages/ --verbose",
    "test:jest:generic": "cd tests/frontend/js && npx jest generic/ --verbose",
    "test:jest:e2e": "cd tests/frontend/js && npx jest e2e/ --verbose",
    "test:playwright": "cd tests/frontend/js && npx playwright test --reporter=list",
    "test:playwright:headed": "cd tests/frontend/js && npx playwright test --headed --reporter=list",
    "test:playwright:debug": "cd tests/frontend/js && npx playwright test --debug",
    "test:eslint": "npx eslint public/assets/js/ --ext .js --max-warnings=50 || true",
    "test:all": "npm run test:jest:core && npm run test && npm run test:playwright"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@tailwindcss/forms": "^0.4.0",
    "@tanstack/react-query": "^5.71.1",
    "@tanstack/react-query-devtools": "^5.72.0",
    "autoprefixer": "^10.4.2",
    "axios": "^1.4.0",
    "context": "^4.0.0",
    "date-fns": "^2.30.0",
    "emoji-mart": "5.5.2",
    "file-type": "^21.3.4",
    "sdk-node-apis-efi": "^1.3.1",
    "i18next": "^22.5.0",
    "i18next-browser-languagedetector": "^6.1.5",
    "lodash": "^4.17.19",
    "markdown-to-jsx": "^7.1.2",
    "mic-recorder-to-mp3": "2.2.2",
    "moment": "^2.29.4",
    "next": "^15.5.18",
    "qrcode.react": "4.1.0",
    "query-string": "^7.1.1",
    "react": "^18.3.1",
    "react-color": "2.19.3",
    "react-copy-to-clipboard": "5.1.0",
    "react-csv": "2.2.2",
    "react-dom": "^18.3.1",
    "react-error-boundary": "5.0.0",
    "react-icons": "^4.8.0",
    "react-input-mask": "^2.0.4",
    "react-modal-image": "^2.5.1",
    "react-number-format": "^4.6.5",
    "react-qr-code": "2.0.15",
    "react-text-mask": "5.5.0",
    "react-trello": "2.2.11",
    "recharts": "^2.1.14",
    "sass": "^1.89.2",
    "socket.io-client": "^4.6.1",
    "sweetalert2": "^11.17.2",
    "tailwindcss": "^3.0.18",
    "text-mask-addons": "3.8.0",
    "use-debounce": "10.0.3",
    "use-sound": "4.0.4",
    "uuid": "^11.1.1",
    "wowjs": "^1.1.3",
    "yup": "1.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@date-io/date-fns": "^2.15.0",
    "@eslint/eslintrc": "^3",
    "@mui/icons-material": "^5.14.0",
    "@mui/lab": "^5.0.0-alpha.125",
    "@mui/material": "^5.17.1",
    "@mui/styles": "^5.14.0",
    "@mui/x-date-pickers": "^6.0.0",
    "@next/eslint-plugin-next": "^15.3.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/node": "^20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "babel-jest": "^29.5.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "eslint": "^9.24.0",
    "eslint-config-next": "15.2.4",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "http-server": "^14.1.1",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.2.0",
    "jquery": "^3.7.1",
    "typescript": "^5",
    "vanilla-cookieconsent": "^2.9.2"
  },
  "overrides": {
    "glob": "^10.0.0",
    "jsdom": "^25.0.0",
    "@tootallnate/once": "^3.0.1",
    "file-type": "^21.3.4",
    "postcss": "^8.5.10",
    "react-trello": {
      "react-redux": "^9.0.0",
      "uuid": "^11.1.1"
    }
  }
}
