includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
    level: 3
    tmpDir: storage/phpstan
    parallel:
        maximumNumberOfProcesses: 1
        processTimeout: 7200.0
    ignoreErrors:
        -
            identifier: missingType.iterableValue
        -
            identifier: missingType.generics
