<?xml version="1.0"?>
<ruleset name="Info Only Rules">
    <description>PHPCS configuration with all rules as info level</description>
    
    <!-- Use PSR12 but reduce all severities to info level -->
    <rule ref="PSR12">
        <!-- Set all rules to severity 1 (info/hint level) -->
        <severity>1</severity>
    </rule>
    
    <!-- Global configuration -->
    <config name="severity" value="1"/>           <!-- All rules at info level -->
    <config name="warning_severity" value="1"/>   <!-- Warnings as info -->
    <config name="error_severity" value="1"/>     <!-- Errors as info -->
    
    <!-- Files to check -->
    <file>app/</file>
    <file>config/</file>
    <file>database/</file>
    <file>routes/</file>
    <file>tests/</file>
    
    <!-- Exclude patterns -->
    <exclude-pattern>vendor/</exclude-pattern>
    <exclude-pattern>storage/</exclude-pattern>
    <exclude-pattern>bootstrap/cache/</exclude-pattern>
    
    <!-- Display options -->
    <arg name="colors"/>
    <arg value="p"/>
    <arg value="s"/>
</ruleset>