{
  "_meta": {
    "description": "All Config\\Constants class aliases and key values used across the codebase",
    "format": "JSON (complex data sets for querying and organizing key:values)",
    "last_updated": "2026-03-01",
    "path_prefix": "_inc/laravel/app/Config/Constants/"
  },

  "class_aliases": {
    "ViewsConstants":      { "alias": "VW",  "file": "ViewsConstants.php",      "purpose": "Route/view path string constants" },
    "PermissionsConstants":{ "alias": "PMC", "file": "PermissionsConstants.php","purpose": "Permission names and user type constants" },
    "DatabaseConstants":   { "alias": "DC",  "file": "DatabaseConstants.php",   "purpose": "DB column name constants" },
    "MiddlewaresConstants":{ "alias": "MWC", "file": "MiddlewaresConstants.php","purpose": "Middleware alias constants" },
    "SeedersTemplating":   { "alias": "ST",  "file": "SeedersTemplating.php",   "purpose": "Seeder permission name definitions" },
    "BaseRoutesConstants": { "alias": "BRC", "file": "BaseRoutesConstants.php", "purpose": "Base route prefix constants" },
    "SettingsConstants":   { "alias": "SC",  "file": "SettingsConstants.php",   "purpose": "Settings table key constants" },
    "UsersConstants":      { "alias": "UC",  "file": "UsersConstants.php",      "purpose": "User type and user field constants" },
    "ExtendingLayoutsConstants": { "alias": "ELC", "file": "ExtendingLayoutsConstants.php", "purpose": "Blade layout extend path constants" },
    "BillsConstants":      { "alias": "BC",  "file": "BillsConstants.php",      "purpose": "Bills module constants" },
    "ProjectsConstants":   { "alias": "PJC", "file": "ProjectsConstants.php",   "purpose": "Projects module constants" }
  },

  "user_types": {
    "PMC::SA":     "super admin",
    "PMC::CPN":    "company",
    "PMC::EMP":    "employee",
    "PMC::HR":     "hr",
    "PMC::AC":     "accountant",
    "PMC::CLIENT": "client",
    "note": "SA bypasses all permission checks in ChecksPermissions::guard()"
  },

  "middleware_aliases": {
    "MWC::AUTH":  "auth (auth:sanctum equivalent)",
    "MWC::GUEST": "guest",
    "MWC::WEB":   "web",
    "MWC::XSS":   "xss (XSSProtection middleware)",
    "MWC::REV":   "verified (EnsureEmailIsVerified)"
  },

  "key_view_constants": {
    "VW::HM":      "home",
    "VW::DSB":     "dashboard",
    "VW::USR":     "users",
    "VW::EMP":     "employees",
    "VW::INV":     "invoices",
    "VW::BIL":     "bills",
    "VW::PPS":     "proposals",
    "VW::CPN":     "coupons",
    "VW::PRJ":     "projects",
    "VW::TSK":     "tasks",
    "VW::TSK_STG": "task_stages",
    "VW::CST":     "customers",
    "VW::VND":     "vendors",
    "VW::PLN":     "plans",
    "VW::RPC":     "reports",
    "VW::LDS":     "leads",
    "VW::DLS":     "deals",
    "VW::EXP":     "expenses",
    "VW::PRH":     "purchases",
    "VW::CON":     "contracts",
    "VW::JOB":     "jobs",
    "note": "Use these constants in routes/web.php — never hardcoded strings"
  },

  "controller_patterns": {
    "base_class":    "App\\Http\\Controllers\\Abstracts\\Controller",
    "traits":        ["ChecksLogin", "ChecksPermissions", "ConsoleOutputs"],
    "guard_pattern": "if (($redirect = self::guard($req, PMC::PERM, REDIRECT)) !== true) return $redirect;",
    "login_check":   "if (($userOrRedirect = self::_checkLogin()) instanceof RedirectResponse) return $userOrRedirect;",
    "view_check":    "if (!View::exists($viewPath)) return $this->viewMissingRedirect(...);",
    "perf_wrapper":  "$this->measureProfile($action, function() { ... })"
  },

  "important_constants_values": {
    "PMC::SA":              "super admin",
    "settings.default_language": "pt-br",
    "settings.company_name":     "Nova Prestech",
    "settings.company_email":    "contato@prestech.com.br",
    "settings.site_currency":    "BRL",
    "settings.site_date_format": "d/m/Y",
    "settings.site_time_format": "H:i"
  }
}
